# Personal API key from Linear → Settings → Security & access → Personal API keys.
# Leave empty to run with demo data.
LINEAR_API_KEY=

# Which issues to plan: a Linear issue view (URL, slug or ID). Defaults to the GX capacity
# planning demo view; set to `all` to sync the whole workspace.
# LINEAR_VIEW=https://linear.app/rideshare-company/view/gx-capacity-planning-demo-subset-30b9a718498a

# Port for the local API server (the UI runs on 5173 in dev and proxies /api here).
PORT=4000
